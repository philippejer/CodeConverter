@model List<Foo.Bar>
@using System.Linq
@{
ViewData["Title"] = "Home";
int n = 3;
}
<h1>@ViewData["Title"]</h1>
@if (Model.Count > 0)
{
        <ul>
@foreach (var item in Model)
{
            <li>@item.Name - @(Html.ActionLink("x", "Edit", new { id = item.Id }))</li>

}
    </ul>

}
else
{
        <p>None</p>

}
@section Scripts {
    <script>var a = 1;</script>
}
